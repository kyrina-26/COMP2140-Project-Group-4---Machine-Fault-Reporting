# Copy this file to .env and change the values as needed.
MYSQL_IMAGE=mysql:8.0
API_IMAGE=comp2140-api:latest
MYSQL_DATABASE=fault_reporting_db
MYSQL_USER=admin
MYSQL_PASSWORD=replace-with-a-unique-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
API_CONTAINER_PORT=8080
APP_UPLOAD_DIR=/app/uploads
APP_MAX_FILE_SIZE=50MB
APP_BOOTSTRAP_ADMIN_USERNAME=admin
# Use a unique password of at least 12 characters.
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-admin-password
APP_BOOTSTRAP_ADMIN_NAME=admin
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_ALLOWED_ORIGINS=*
