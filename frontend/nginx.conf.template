server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    absolute_redirect off;

    location /api/ {
        proxy_pass http://api:${API_CONTAINER_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = / {
        return 302 /login/login.html;
    }

    location = /login {
        return 301 /login/login.html;
    }

    location = /login/ {
        return 301 /login/login.html;
    }

    location = /fault-report {
        return 301 /fault-report/fault-report.html;
    }

    location = /fault-report/ {
        return 301 /fault-report/fault-report.html;
    }

    location = /maintenance-dashboard {
        return 301 /maintenance-dashboard/maintenance-dashboard.html;
    }

    location = /maintenance-dashboard/ {
        return 301 /maintenance-dashboard/maintenance-dashboard.html;
    }

    location / {
        try_files $uri =404;
    }
}
